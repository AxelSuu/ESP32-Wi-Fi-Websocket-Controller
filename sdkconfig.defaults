CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# M5 robustness ------------------------------------------------------------
# OTA rollback: a freshly-OTA'd image boots PENDING_VERIFY and is only marked
# valid after the firmware proves healthy (see ota_mark_valid_if_pending in
# main.c); otherwise the bootloader reverts to the previous slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Task watchdog: subscribed to the game task; a hung tick()/render reboots.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y

# Core dump to the dedicated 'coredump' partition for post-mortem backtraces.
# IDF v6 always writes ELF with a SHA256 checksum; there is nothing else to pick.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
